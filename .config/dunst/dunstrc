[global]
    monitor = DP-1
    follow = none
    width = 360
    height = 140
    origin = top-right
    offset = 4x4
    scale = 0
    notification_limit = 8

    progress_bar = true
    progress_bar_height = 8
    progress_bar_min_width = 140
    progress_bar_max_width = 300
    progress_bar_corner_radius = 6

    icon_corner_radius = 8
    corner_radius = 12
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 12
    gap_size = 10
    separator_height = 0
    frame_width = 2
    frame_color = "#000365"

    font = Lexend 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = true
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    background = "#000000EE"
    foreground = "#FFFFFF"
    highlight = "#000365"

[urgency_low]
    timeout = 4
    background = "#000000E6"
    foreground = "#CFCFCF"
    frame_color = "#2C71C0"
    highlight = "#2C71C0"

[urgency_normal]
    timeout = 6
    background = "#000000EE"
    foreground = "#FFFFFF"
    frame_color = "#000365"
    highlight = "#000365"

[urgency_critical]
    timeout = 0
    background = "#14060C"
    foreground = "#FFFFFF"
    frame_color = "#FF5C8A"
    highlight = "#FF5C8A"
